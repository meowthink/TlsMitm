<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>Router</AssemblyName>
    <RootNamespace>Router</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Linked rather than copied: one P/Invoke surface for both programs. The class keeps its
         TlsMitm namespace and its resource names, so the driver auto-loader inside it finds the
         binaries embedded below without a conditional. InboundFirewall travels the same way: it is the
         rule store read and the one rule a run owns, and neither program asks it anything else. So does
         RelayProbe, which is the SYN and the connection-table reading that answers a question the rule
         store cannot: Router aims it at the resolver's TCP port, the proxy at its relay. -->
    <Compile Include="..\TlsMitm\WinDivertNative.cs" Link="WinDivertNative.cs" />
    <Compile Include="..\TlsMitm\InboundFirewall.cs" Link="InboundFirewall.cs" />
    <Compile Include="..\TlsMitm\RelayProbe.cs" Link="RelayProbe.cs" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\TlsMitm\windivert\x64\WinDivert.dll" LogicalName="TlsMitm.windivert.x64.WinDivert.dll" />
    <EmbeddedResource Include="..\TlsMitm\windivert\x64\WinDivert64.sys" LogicalName="TlsMitm.windivert.x64.WinDivert64.sys" />
    <!-- The two embedded binaries are distributed under LGPL-3.0, which requires the license text
         to travel with them. -->
    <None Include="..\TlsMitm\windivert\COPYING" Link="COPYING">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="..\TlsMitm\windivert\COPYING.LESSER" Link="COPYING.LESSER">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
