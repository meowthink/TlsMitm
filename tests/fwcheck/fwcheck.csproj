<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>fwcheck</AssemblyName>
    <RootNamespace>FwCheck</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Linked rather than referenced, as in flowcheck: FlowTable is internal to TlsMitm, and a project
         reference would pull a second copy of the driver's P/Invoke surface into this assembly. -->
    <Compile Include="..\..\TlsMitm\FlowTable.cs" Link="FlowTable.cs" />
    <Compile Include="..\..\TlsMitm\RelayProbe.cs" Link="RelayProbe.cs" />
    <Compile Include="..\..\TlsMitm\LanSide.cs" Link="LanSide.cs" />
    <Compile Include="..\..\TlsMitm\InboundFirewall.cs" Link="InboundFirewall.cs" />
  </ItemGroup>

</Project>
