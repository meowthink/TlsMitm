<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>flowcheck</AssemblyName>
    <RootNamespace>FlowCheck</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Linked rather than referenced: FlowTable is internal to TlsMitm, and a project reference would
         bring a copy of WinDivertNative.cs into this assembly beside the driver-free one it builds. -->
    <Compile Include="..\..\TlsMitm\FlowTable.cs" Link="FlowTable.cs" />
  </ItemGroup>

</Project>
