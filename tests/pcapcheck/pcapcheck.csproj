<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>pcapcheck</AssemblyName>
    <RootNamespace>PcapCheck</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Linked rather than referenced: PcapWriter is self-contained (no driver), and a project reference
         would bring the whole proxy in beside it. -->
    <Compile Include="..\..\TlsMitm\PcapWriter.cs" Link="PcapWriter.cs" />
  </ItemGroup>

</Project>
