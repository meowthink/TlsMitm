<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AssemblyName>chainprobe</AssemblyName>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\TlsMitm\TlsMitm.csproj" />
    <!-- floor sends hellos assembled by the same builder the JA3/JA4 check judges, so the bytes this
         mode feeds the terminator are the bytes that decoder is known to read correctly. -->
    <ProjectReference Include="..\..\tools\hellofingerprint\hellofingerprint.csproj" />
  </ItemGroup>
</Project>
