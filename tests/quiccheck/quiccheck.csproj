<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>quiccheck</AssemblyName>
    <RootNamespace>QuicCheck</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Linked rather than referenced for the same reason natcheck links LanSide: this suite is about
         the packet parser, and a project reference would drag the whole application in with it. -->
    <Compile Include="..\..\TlsMitm\QuicSignature.cs" Link="QuicSignature.cs" />
    <Compile Include="..\..\TlsMitm\WinDivertNative.cs" Link="WinDivertNative.cs" />
  </ItemGroup>

</Project>
