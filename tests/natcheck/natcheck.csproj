<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>natcheck</AssemblyName>
    <RootNamespace>NatCheck</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Router\Router.csproj" />
    <!-- Linked rather than referenced: TlsMitm also ships WinDivertNative.cs, and a project reference
         would bring a second copy of that type in beside the one Router builds. -->
    <Compile Include="..\..\TlsMitm\LanSide.cs" Link="LanSide.cs" />
  </ItemGroup>

</Project>
