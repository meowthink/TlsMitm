<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>inject</AssemblyName>
    <RootNamespace>Inject</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Linked rather than copied, the way Router.csproj does it: one P/Invoke surface for all
         programs here. The class keeps its TlsMitm namespace and resource names so the driver
         auto-loader inside it finds the binaries embedded below. -->
    <Compile Include="..\..\TlsMitm\WinDivertNative.cs" Link="WinDivertNative.cs" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\TlsMitm\windivert\x64\WinDivert.dll" LogicalName="TlsMitm.windivert.x64.WinDivert.dll" />
    <EmbeddedResource Include="..\..\TlsMitm\windivert\x64\WinDivert64.sys" LogicalName="TlsMitm.windivert.x64.WinDivert64.sys" />
    <!-- The two embedded binaries are distributed under LGPL-3.0, which requires the license text
         to travel with them. -->
    <None Include="..\..\TlsMitm\windivert\COPYING" Link="COPYING">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="..\..\TlsMitm\windivert\COPYING.LESSER" Link="COPYING.LESSER">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
