<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>pdprobe</AssemblyName>
    <RootNamespace>PdProbe</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- The point of this tool is to drive the product's own client, so it references Router rather than
         linking one file. No WinDivert, no elevation: an exchange that failed in a live run can be read
         message by message from an ordinary window. -->
    <ProjectReference Include="..\..\Router\Router.csproj" />
  </ItemGroup>

</Project>
